{
  "name": "uir-highlight",
  "displayName": "tinygrad UIR Highlight",
  "description": "Syntax highlighting for tinygrad and studentgrad UIR (.uir) files, with tinygrad-style op colors.",
  "version": "0.2.6",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:uir"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "uir",
        "aliases": [
          "UIR",
          "tinygrad UIR",
          "studentgrad UIR"
        ],
        "extensions": [
          ".uir"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "uir",
        "scopeName": "source.uir",
        "path": "./syntaxes/uir.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "gen": "node gen_grammar.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
